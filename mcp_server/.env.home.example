# Copy to mcp_server/.env and fill in. Never commit the real .env.

# Unguessable URL segment for the MCP endpoint (>= 32 chars). Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_SECRET_PATH=

# Your Tailscale Funnel hostname (comma-separate several). Enables DNS rebinding protection.
MCP_ALLOWED_HOSTS=homeserver.tailXXXX.ts.net

# Your name, so "I"/"my" from every agent resolves to the same person in the graph.
MEMORY_OWNER_NAME=

# Extraction + embeddings. OpenAI is used for both by default.
OPENAI_API_KEY=
# Optional: use Claude for extraction instead (embeddings still use OpenAI)
# LLM_PROVIDER=anthropic
# MODEL_NAME=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# Optional
# FALKORDB_PASSWORD=
# GRAPHITI_GROUP_ID=personal
# SEMAPHORE_LIMIT=5
# BROWSER=1
